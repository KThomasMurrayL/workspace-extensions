{
  "name": "obsidian-notes",
  "displayName": "Obsidian Notes",
  "description": "Obsidian-style markdown note taking in VS Code: notes tree, daily notes, [[wiki links]] and image uploads stored in your workspace.",
  "version": "0.1.0",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "notes",
    "obsidian",
    "markdown",
    "wiki"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onView:obsidianNotes.notesView",
    "onLanguage:markdown",
    "onCommand:obsidianNotes.newNote",
    "onCommand:obsidianNotes.newFolder",
    "onCommand:obsidianNotes.openDailyNote",
    "onCommand:obsidianNotes.insertImage",
    "onCommand:obsidianNotes.openPreview",
    "onCommand:obsidianNotes.renameNote",
    "onCommand:obsidianNotes.deleteNote",
    "onCommand:obsidianNotes.revealNote",
    "onCommand:obsidianNotes.openNotesFolder",
    "onCommand:obsidianNotes.refresh"
  ],
  "contributes": {
    "commands": [
      {
        "command": "obsidianNotes.newNote",
        "title": "New Note",
        "category": "Notes",
        "icon": "$(new-file)"
      },
      {
        "command": "obsidianNotes.newFolder",
        "title": "New Folder",
        "category": "Notes",
        "icon": "$(new-folder)"
      },
      {
        "command": "obsidianNotes.openDailyNote",
        "title": "Open Today's Note",
        "category": "Notes",
        "icon": "$(calendar)"
      },
      {
        "command": "obsidianNotes.insertImage",
        "title": "Insert Image",
        "category": "Notes",
        "icon": "$(file-media)"
      },
      {
        "command": "obsidianNotes.openPreview",
        "title": "Open Preview",
        "category": "Notes",
        "icon": "$(open-preview)"
      },
      {
        "command": "obsidianNotes.renameNote",
        "title": "Rename",
        "category": "Notes",
        "icon": "$(edit)"
      },
      {
        "command": "obsidianNotes.deleteNote",
        "title": "Delete",
        "category": "Notes",
        "icon": "$(trash)"
      },
      {
        "command": "obsidianNotes.revealNote",
        "title": "Reveal in File Explorer",
        "category": "Notes",
        "icon": "$(go-to-file)"
      },
      {
        "command": "obsidianNotes.openNotesFolder",
        "title": "Open Notes Folder",
        "category": "Notes",
        "icon": "$(folder-opened)"
      },
      {
        "command": "obsidianNotes.refresh",
        "title": "Refresh",
        "category": "Notes",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "obsidianNotes",
          "title": "Notes",
          "icon": "media/notes.svg"
        }
      ]
    },
    "views": {
      "obsidianNotes": [
        {
          "id": "obsidianNotes.notesView",
          "name": "Notes"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "obsidianNotes.newNote",
          "when": "view == obsidianNotes.notesView",
          "group": "navigation@1"
        },
        {
          "command": "obsidianNotes.newFolder",
          "when": "view == obsidianNotes.notesView",
          "group": "navigation@2"
        },
        {
          "command": "obsidianNotes.openDailyNote",
          "when": "view == obsidianNotes.notesView",
          "group": "navigation@3"
        },
        {
          "command": "obsidianNotes.refresh",
          "when": "view == obsidianNotes.notesView",
          "group": "navigation@4"
        },
        {
          "command": "obsidianNotes.openNotesFolder",
          "when": "view == obsidianNotes.notesView",
          "group": "1_actions"
        }
      ],
      "view/item/context": [
        {
          "command": "obsidianNotes.newNote",
          "when": "view == obsidianNotes.notesView && viewItem == folder",
          "group": "inline@1"
        },
        {
          "command": "obsidianNotes.renameNote",
          "when": "view == obsidianNotes.notesView && viewItem =~ /^(note|image|folder)$/",
          "group": "inline@2"
        },
        {
          "command": "obsidianNotes.deleteNote",
          "when": "view == obsidianNotes.notesView && viewItem =~ /^(note|image|folder)$/",
          "group": "inline@3"
        },
        {
          "command": "obsidianNotes.revealNote",
          "when": "view == obsidianNotes.notesView && viewItem =~ /^(note|image|folder)$/",
          "group": "2_actions"
        }
      ],
      "editor/title": [
        {
          "command": "obsidianNotes.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "obsidianNotes.insertImage",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Notes",
      "properties": {
        "obsidianNotes.notesFolder": {
          "type": "string",
          "default": "notes",
          "description": "Workspace-relative folder where notes are stored."
        },
        "obsidianNotes.assetsFolder": {
          "type": "string",
          "default": "notes/assets",
          "description": "Workspace-relative folder where uploaded images are copied."
        },
        "obsidianNotes.imageSyntax": {
          "type": "string",
          "enum": [
            "markdown",
            "wiki"
          ],
          "default": "markdown",
          "description": "markdown: ![](relative/path.png) \u2014 renders in the built-in preview. wiki: ![[relative/path.png]] \u2014 Obsidian style."
        },
        "obsidianNotes.linkCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Suggest notes and images when typing [[ or ![[ in markdown files."
        }
      }
    }
  },
  "scripts": {
    "check": "node --check src/extension.js && node --check src/tree.js && node --check src/util.js && node --check src/links.js"
  }
}
